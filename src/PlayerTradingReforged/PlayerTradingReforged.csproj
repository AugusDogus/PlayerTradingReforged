<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>PlayerTradingReforged</AssemblyName>
    <RootNamespace>PlayerTradingReforged</RootNamespace>
    <Version>1.2.0</Version>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.2" PrivateAssets="all" />
    <Reference Include="$(ManagedDir)/assembly_valheim.dll" Publicize="true" Private="false" ExternallyResolved="true" />
    <Reference Include="$(ManagedDir)/assembly_utils.dll" Publicize="true" Private="false" ExternallyResolved="true" />
    <Reference Include="$(ManagedDir)/assembly_guiutils.dll" Publicize="true" Private="false" ExternallyResolved="true" />
    <Reference Include="$(ManagedDir)/UnityEngine*.dll" Private="false" ExternallyResolved="true" />
    <Reference Include="$(ManagedDir)/Unity.TextMeshPro.dll" Private="false" ExternallyResolved="true" />
    <Reference Include="$(BepInExDir)/core/BepInEx.dll" Private="false" ExternallyResolved="true" />
    <Reference Include="$(BepInExDir)/core/0Harmony.dll" Private="false" ExternallyResolved="true" />
  </ItemGroup>
  <Target Name="CheckGameReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(ManagedDir)/assembly_valheim.dll')" Text="Valheim assemblies missing. Set GameDir to your game installation or ManagedDir to its Managed directory." />
    <Error Condition="!Exists('$(BepInExDir)/core/BepInEx.dll')" Text="BepInEx assemblies missing. Set BepInExDir to your mod profile's BepInEx directory." />
  </Target>
  <Import Project="../../build/Package.targets" />
</Project>
